makensis 3.13 su macOS non compila script Unicode: iconv mappa "wchar_t"
su UCS-2 mentre wchar_t e' UTF-32, quindi CharEncConv::Convert() restituisce
NULL e ExeHeadStringList::add() lancia std::bad_alloc (bug upstream #1333).
La patch usa "UTF-32LE" quando sizeof(wchar_t) == 4.

Applicazione sulla sorgente NSIS 3.13:

  tar -xjf nsis-3.13-src.tar.bz2
  cd nsis-3.13-src
  patch -p1 < nsis-macos-iconv.patch
  scons SKIPSTUBS=all SKIPPLUGINS=all SKIPUTILS=all SKIPMISC=all makensis

Il binario prodotto si passa alla build con MAKENSIS=... (vedi
DISTRIBUTION.md).

--- a/Source/util.h
+++ b/Source/util.h
@@ -32,6 +32,25 @@
 #include <stdarg.h>
 #include <stdio.h>
 
+#ifndef _WIN32
+// iconv on macOS maps "wchar_t" to UCS-2 while the platform wchar_t is
+// UTF-32, so makensis aborts with std::bad_alloc on any Unicode script
+// (NSIS bug #1333). Ask iconv for the encoding wchar_t really is.
+#ifndef NSIS_ICONV_WCHAR
+#if defined(__SIZEOF_WCHAR_T__) && __SIZEOF_WCHAR_T__ == 4
+#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define NSIS_ICONV_WCHAR "UTF-32BE"
+#else
+#define NSIS_ICONV_WCHAR "UTF-32LE"
+#endif
+#else
+#define NSIS_ICONV_WCHAR "wchar_t"
+#endif
+#endif
+#endif
+
+
+
 static inline bool ui_add(unsigned int &r, unsigned int a, unsigned int b) { return (r = a + b) >= a; }
 static inline bool si_add(int &r, int a, int b)
 {
